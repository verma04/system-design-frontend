style.
  .customMobile,
  .custom-socialicons {
    display: none !important;
  }
  .footer-v2 {
    background-color: #f7f3eb;
    color: #333;
    font-family: lato-regular;
    padding: 0px 0px 30px;
  }
  .footer-v2 .main-footer {
    border-top: 1px solid #333;
    border-bottom: 1px solid #333;
  }
  h3.footer-heading {
    font-size: 20px;
    font-family: 'Playfair Display';
    color: #333;
  }
  .footer-v2 input::placeholder {
    font-family: 'lato-regular';
    color: #333;
  }
  .footer-v2 ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .footer-v2 ul li {
    margin-bottom: 8px;
  }
  .footer-v2 ul li a {
    text-decoration: none;
    color: #333;
    font-size: 16px;
  }
  span.newsletter-form {
    display: none;
    border: 1px solid #2b2b2b;
    border-radius: 5px;
    margin-bottom: 10px;

  }
  .footer-v2 input[type="email"] {
    width: 90%;
    padding: 25px 15px;
    border-radius: 4px;
    font-size: 16px;
    background-color: transparent;
    border: 0px;
    font-family: 'lato-regular';
  }
  .footer-v2 .social-handels a {
    display: inline-block;
    margin-right: 10px;
    font-size: 18px;
    color: #2b2b2b;
  }
  .footer-v2 .logo-section {
    text-align: center;
    margin: 40px 0 10px;
  }
  .footer-v2 .logo-section img {
    max-height: 40px;
  }
  .footer-v2 .footer-bottom {
    font-size: 16px;
    padding-top: 20px;
  }
  .footer-v2 .footer-bottom span {
    color: #333;
    font-family: 'lato-regular';
  }
  .pulseplay-text {
    text-align: end;
  }
  .btn-subscribe {
    background-color: #EAE2D0;
    color: #333;
    border: none;
    padding: 12px 1px;
    font-size: 16px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-left: 1px solid #2b2b2b;
    cursor: pointer;
    width: 11%;
  }
  .btn-subscribe:hover {
    background-color: #6a246f;
    color: #fff;
  }
  .grecaptcha-badge {
    visibility: hidden !important;
  }
  @media screen and (max-width: 1199px) {
    .footer-v2 {
      padding: 30px 0px 80px;
    }
  }
  @media screen and (max-width: 767px) {
    .customMobile,
    .custom-socialicons {
      display: block !important;
    }
    .customDesktop {
      display: none;
    }
    .footer-v2 .footer-bottom,
    .pulseplay-text {
      text-align: center;
    }
    .footer-v2 ul li {
      margin-bottom: 3px;
    }
    .footer-v2 ul li a {
      text-decoration: none;
      color: #333;
      font-size: 11px;
      line-height: normal;
    }
    .social-handels {
      justify-content: center !important;
    }
    .customMobile p {
      font-size: 12px;
    }
  }

