style.
  .menu-link {
    position: relative;
  }
  .dropdown-arrow {
    margin-left: auto;
    font-size: 14px;
    margin-left: 8px;
  }
  ul.menu.dropdown-child li {
    list-style: none;
  }
  .dropdown-child li.menu-link.position-relative {
    text-align: left;
    padding: 10px 30px;
    font-size: 22px;
  }
  .menu.dropdown-child li.menu-link.position-relative:hover {
    background-color: rgb(95, 50, 104);
  }
  .menu.dropdown-child li.menu-link.position-relative:hover a {
    color: #fff !important;
  }
  .menu .dropdown-child,
  .menu .dropdown-grandchild {
    display: none;
    position: absolute;
    background: #fff;
    box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.1);
    min-width: 150px;
    padding: 20px 0px;
    margin-left: 30px;
  }
  .menu .dropdown-child {
    top: 100%;
    left: 0;
  }
  .menu .dropdown-grandchild {
    top: 0;
    left: 100%;
  }
  .menu-link:hover>.dropdown-child {
    display: block;
  }
  .menu-link:hover>a>.dropdown-arrow {
    transform: rotate(180deg);
  }
